{
  "breakpoint": {
    "sm": {
      "$type": "dimension",
      "$value": "640px",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
            "WEB": "var(--breakpoint-sm)"
          }
        }
      }
    },
    "md": {
      "$type": "dimension",
      "$value": "768px",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
