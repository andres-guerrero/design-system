          }
        }
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": "1024px",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
            "WEB": "var(--breakpoint-lg)"
          }
        }
      }
    },
    "xl": {
      "$type": "dimension",
      "$value": "1280px",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
